# Copy to .env and fill in real keys. Never commit .env.
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
LLM_PROVIDER_PREFIX=openai
LLM_MAX_TOKENS=4096

# Optional tools. Without valid keys the agents fall back to model knowledge
# and must label it as "needs verification".
TAVILY_API_KEY=
AMAP_API_KEY=

# Keep CrewAI from prompting for trace sharing in the web app.
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_VERSION_CHECK=true
