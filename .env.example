# 复制成 .env 再填。.env 永远不进 git。
DEEPSEEK_API_KEY=

# 模型名必须是接口支持的。这个端点目前认：deepseek-flash / deepseek-v4-pro
MODEL_NAME=deepseek-flash
VISION_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 高德：天气 + 路线 + 地点搜索 + 点位实景图（一个 key 全包）
AMAP_API_KEY=

# 联网搜索（可选）
TAVILY_API_KEY=

# 1 = 强制走规则，不调任何模型；留空则"有 key 就用模型"
DEMO_MODE=0

# 排程参数
DB_PATH=data/travel.db
DAY_BUDGET_MIN=480
MAX_ITEMS_PER_DAY=3

# 少打扰：关掉 CrewAI 的 trace 询问和版本检查
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_VERSION_CHECK=true

# 1 = 写攻略时开深度思考（更细但慢一倍）；0 = 关掉换速度
THINK=1
